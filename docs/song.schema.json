{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chip music project v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "title",
    "bpm",
    "ppq",
    "bars",
    "hz",
    "loop",
    "loopStart",
    "opllPatch",
    "tracks"
  ],
  "properties": {
    "format": {
      "const": "msx-music-studio"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "bpm": {
      "type": "integer",
      "minimum": 40,
      "maximum": 300
    },
    "ppq": {
      "const": 96
    },
    "bars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "hz": {
      "enum": [
        50,
        60
      ]
    },
    "loop": {
      "type": "boolean"
    },
    "loopStart": {
      "type": "integer",
      "minimum": 0,
      "maximum": 24575
    },
    "opllPatch": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 17,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "chip",
          "channel",
          "instrument",
          "wave",
          "mute",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "chip": {
            "enum": [
              "PSG",
              "OPLL",
              "SCC",
              "OPM"
            ]
          },
          "channel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "instrument": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "wave": {
            "type": "array",
            "minItems": 32,
            "maxItems": 32,
            "items": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            }
          },
          "mute": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "pitch",
                "start",
                "duration",
                "velocity"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "pitch": {
                  "type": "integer",
                  "minimum": 24,
                  "maximum": 95
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 24575
                },
                "duration": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 24576
                },
                "velocity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 15
                },
                "noisePeriod": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31
                },
                "decayMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2000
                },
                "instrument": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15,
                  "description": "Optional; melodic OPLL only. See AI_COMPOSITION.md."
                },
                "detuneCents": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100,
                  "description": "Optional; melodic OPLL or OPM. See AI_COMPOSITION.md."
                },
                "vibratoDepth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Optional; melodic OPLL or OPM. See AI_COMPOSITION.md."
                },
                "vibratoRate": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100,
                  "description": "Optional; melodic OPLL or OPM. See AI_COMPOSITION.md."
                },
                "vibratoDelayMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2000,
                  "description": "Optional; melodic OPLL or OPM. See AI_COMPOSITION.md."
                },
                "portamentoFrom": {
                  "type": "integer",
                  "minimum": 24,
                  "maximum": 95,
                  "description": "Optional; melodic OPLL or OPM. See AI_COMPOSITION.md."
                },
                "portamentoMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2000,
                  "description": "Optional; melodic OPLL or OPM. See AI_COMPOSITION.md."
                }
              }
            }
          },
          "psgMode": {
            "type": "string",
            "enum": [
              "tone",
              "noise",
              "drums"
            ]
          },
          "noisePeriod": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "decayMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "opmPatch": {
            "type": "object",
            "required": [
              "algorithm",
              "feedback",
              "operators"
            ],
            "properties": {
              "algorithm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "feedback": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "operators": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "dt1",
                    "mul",
                    "tl",
                    "ks",
                    "ar",
                    "d1r",
                    "d2r",
                    "dt2",
                    "sl",
                    "rr"
                  ],
                  "properties": {
                    "dt1": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 7
                    },
                    "mul": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 15
                    },
                    "tl": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 127
                    },
                    "ks": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    },
                    "ar": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 31
                    },
                    "d1r": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 31
                    },
                    "d2r": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 31
                    },
                    "dt2": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    },
                    "sl": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 15
                    },
                    "rr": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 15
                    }
                  }
                }
              }
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "Optional per-track display color; does not affect audio."
          }
        }
      }
    },
    "opllRhythm": {
      "type": "boolean",
      "default": false,
      "description": "Optional. Six melodic OPLL channels plus rhythm on channels 6..8 (zero-based); see AI_COMPOSITION.md."
    },
    "opmEnabled": {
      "type": "boolean",
      "default": false,
      "description": "Optional SFG/YM2151 8 channels. MGSDRV export forbidden while enabled."
    },
    "loopEnd": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24576,
      "description": "Optional exclusive loop end in PPQ ticks; active only when loop is true. Notes remain stored."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "opmEnabled"
        ],
        "properties": {
          "opmEnabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "tracks": {
            "minItems": 25,
            "maxItems": 25
          }
        }
      },
      "else": {
        "properties": {
          "tracks": {
            "minItems": 17,
            "maxItems": 17
          }
        }
      }
    }
  ]
}
